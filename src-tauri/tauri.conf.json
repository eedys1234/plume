{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plume",
  "mainBinaryName": "plume",
  "version": "0.1.0",
  "identifier": "kr.colosseum.apigen",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Plume — API Design Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/OWNER/REPO/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyMUQ0RTQwOTIwRjJGMjcKUldRbkx3K1NRRTRkRXI2RHBZMUNJeDZzdnhjWnc0VnJ1aVlVY3dEOHJFQlRBVTdrVlY0QXVrU0sK"
    }
  }
}
